# LLM provider keys. Copy to .env and fill in what you use.
# .env is gitignored — never commit real keys.
# (All of this can also be set in the app's Settings UI.)

# Ollama cloud (blank host/key = local daemon at localhost:11434)
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=...

# LM Studio / OpenAI-compatible server
# COMPAT_BASE_URL=http://localhost:1234/v1
# COMPAT_API_KEY=

# Cloud providers
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Transcription defaults
# MINUTENEST_MODEL=large-v3
# MINUTENEST_DEVICE=cuda
# MINUTENEST_COMPUTE_TYPE=float16
# MINUTENEST_LANGUAGE=ru

# Launcher
# MINUTENEST_NO_BROWSER=1   # do not auto-open the browser